# Address of the IndustriaLink backend API.
# On a real phone use the computer's Wi-Fi address, or run: adb reverse tcp:4000 tcp:4000
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Google sign-in: the Web OAuth client ID from Google Cloud (not secret). Empty = Google button says it's not available.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
