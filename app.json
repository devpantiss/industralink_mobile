{
  "expo": {
    "name": "IndustriaLink",
    "slug": "industrialink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "industrialink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pantiss.industrialink",
      "infoPlist": {
        "NSCameraUsageDescription": "IndustriaLink uses the camera so you can take a photo of your certificates and add a profile photo.",
        "NSPhotoLibraryUsageDescription": "IndustriaLink uses your photos so you can upload certificates, your resume and a profile photo."
      }
    },
    "android": {
      "package": "com.pantiss.industrialink",
      "adaptiveIcon": {
        "backgroundColor": "#2454E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "IndustriaLink needs your photos to upload certificates and a profile photo."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2454E6"
        }
      ]
    ]
  }
}
