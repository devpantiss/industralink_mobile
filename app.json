{
  "expo": {
    "name": "IndustriaLink",
    "slug": "industrialink",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "industrialink",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pantiss.industrialink",
      "infoPlist": {
        "NSCameraUsageDescription": "IndustriaLink uses the camera so you can take a photo of your certificates and add a profile photo.",
        "NSPhotoLibraryUsageDescription": "IndustriaLink uses your photos so you can upload certificates, your resume and a profile photo."
      }
    },
    "android": {
      "package": "com.pantiss.industrialink",
      "adaptiveIcon": {
        "backgroundColor": "#2454E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "IndustriaLink needs your photos to upload certificates and a profile photo."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0B0D12"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IndustriaLink uses your location to show jobs near you."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2454E6",
          "defaultChannel": "updates"
        }
      ],
      "react-native-nitro-google-signin"
    ]
  }
}
